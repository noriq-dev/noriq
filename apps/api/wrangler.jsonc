// Generic config — deploys to <name>.workers.dev out of the box and drives local
// dev + tests. For a real instance (custom domain, email, attachments), copy
// wrangler.production.jsonc.example to wrangler.production.jsonc (gitignored)
// and fill in your values; npm run deploy prefers it automatically.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noriq",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Ask answer budget and actor-lifecycle retention policy. Lifecycle numeric values are parsed,
  // clamped, and reported by the sweep. Scheduled mutation is deliberately opt-in; operators can
  // review the dry-run endpoint before setting AGENT_LIFECYCLE_SWEEP_APPLY to "true".
  "vars": {
    "ASK_MAX_OUTPUT_TOKENS": "4096",
    "ASK_MODELS": "[{\"id\":\"@cf/openai/gpt-oss-120b\",\"label\":\"GPT-OSS 120B\",\"capabilities\":{\"tools\":true,\"streaming\":true,\"reasoningSummary\":true}}]",
    "ASK_DEFAULT_MODEL": "@cf/openai/gpt-oss-120b",
    "AGENT_LIFECYCLE_ONLINE_SECONDS": "300",
    "AGENT_COPILOT_RETIRE_DAYS": "7",
    "AGENT_HISTORY_ARCHIVE_DAYS": "30",
    "AGENT_PRESENCE_PURGE_DAYS": "90",
    "RUNNER_OFFLINE_ARCHIVE_DAYS": "30",
    "AGENT_LIFECYCLE_SWEEP_BATCH": "100",
    "AGENT_LIFECYCLE_SWEEP_APPLY": "false"
  },

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/ws", "/ws/*", "/oauth/*", "/.well-known/*", "/skill.md", "/skill/*", "/skill.zip", "/noriq.zip", "/reference.md", "/reference.json"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOM", "class_name": "ProjectRoom" },
      { "name": "AGENT_SESSION", "class_name": "AgentSession" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "RUNNER_HUB", "class_name": "RunnerHub" },
      { "name": "PROJECT_MEMORY", "class_name": "ProjectMemory" },
      { "name": "ASK_GENERATION", "class_name": "AskGeneration" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectRoom", "AgentSession"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v3", "new_sqlite_classes": ["RunnerHub"] },
    { "tag": "v4", "new_sqlite_classes": ["ProjectMemory"] },
    { "tag": "v5", "new_sqlite_classes": ["AskGeneration"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noriq",
      "database_id": "00000000-0000-0000-0000-000000000000", // replace via wrangler d1 create noriq
      "migrations_dir": "migrations"
    }
  ],

  // Email invites + attachments are configured in wrangler.production.jsonc
  // (see the .example) — both optional, Noriq degrades gracefully without them.

  // Daily D1 backup to R2 at 06:00 UTC (PLNR-21). No-op until R2 (FILES) is bound;
  // safe to keep enabled. Snapshots land under backups/ — see BACKUP.md to restore.
  // Semantic search (PLNR-184). AI = Workers AI embeddings (no provisioning needed).
  // VECTORIZE is opt-in: create the index first, then uncomment (or add it to your
  // wrangler.production.jsonc):
  //   wrangler vectorize create noriq-search --dimensions=1024 --metric=cosine
  //   wrangler vectorize create-metadata-index noriq-search --property-name=projectId --type=string
  // Without both bindings, search transparently degrades to keyword matching.
  //
  // Code-intelligence search (PLNR-256, §9) is a SEPARATE, independently optional index — files,
  // symbols, APIs, tests, config/schema entities, repository docs. Missing it (or AI) degrades
  // code retrieval to lexical + graph; missing it never affects the noriq-search index above.
  // See env.ts's CODE_VECTORIZE doc comment for its three required metadata-index commands
  // (projectId, repositoryKey, AND generationId).
  //   wrangler vectorize create noriq-code --dimensions=1024 --metric=cosine
  //   wrangler vectorize create-metadata-index noriq-code --property-name=projectId --type=string
  //   wrangler vectorize create-metadata-index noriq-code --property-name=repositoryKey --type=string
  //   wrangler vectorize create-metadata-index noriq-code --property-name=generationId --type=string
  "ai": { "binding": "AI" },
  // "vectorize": [
  //   { "binding": "VECTORIZE", "index_name": "noriq-search" },
  //   { "binding": "CODE_VECTORIZE", "index_name": "noriq-code" }
  // ],

  "triggers": { "crons": ["0 6 * * *"] },

  "observability": { "enabled": true }
}
