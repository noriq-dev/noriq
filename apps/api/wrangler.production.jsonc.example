// Your instance's deployment config — copy to wrangler.production.jsonc (gitignored)
// and fill in your values. `npm run deploy` picks it up automatically when present;
// without it, the generic wrangler.jsonc deploys to <name>.workers.dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noriq",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Your custom domain (zone must be on your Cloudflare account). Wrangler
  // creates the DNS record + certificate on deploy. Delete to use workers.dev.
  "routes": [{ "pattern": "noriq.example.com", "custom_domain": true }],

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/ws", "/ws/*", "/oauth/*", "/.well-known/*", "/skill.md", "/skill/*", "/skill.zip", "/noriq.zip", "/reference.md", "/reference.json"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOM", "class_name": "ProjectRoom" },
      { "name": "AGENT_SESSION", "class_name": "AgentSession" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "RUNNER_HUB", "class_name": "RunnerHub" },
      { "name": "PROJECT_MEMORY", "class_name": "ProjectMemory" },
      { "name": "ASK_GENERATION", "class_name": "AskGeneration" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectRoom", "AgentSession"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v3", "new_sqlite_classes": ["RunnerHub"] },
    { "tag": "v4", "new_sqlite_classes": ["ProjectMemory"] },
    { "tag": "v5", "new_sqlite_classes": ["AskGeneration"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noriq",
      "database_id": "<your d1 database id from: wrangler d1 create noriq>",
      "migrations_dir": "migrations"
    }
  ],

  // OPTIONAL — email invites. Requires: wrangler email sending enable <your-domain>
  // Delete both if unused; invites fall back to copyable links.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Keep this aligned with the route above. It supplies absolute links when no request
    // origin exists (scheduled work, signal webhooks, and agent upload capabilities).
    "PUBLIC_ORIGIN": "https://noriq.example.com",
    "EMAIL_FROM": "noriq@example.com",
    "ASK_MAX_OUTPUT_TOKENS": "8192",
    "AGENT_LIFECYCLE_ONLINE_SECONDS": "300",
    "AGENT_COPILOT_RETIRE_DAYS": "7",
    "AGENT_HISTORY_ARCHIVE_DAYS": "30",
    "AGENT_PRESENCE_PURGE_DAYS": "90",
    "RUNNER_OFFLINE_ARCHIVE_DAYS": "30",
    "AGENT_LIFECYCLE_SWEEP_BATCH": "100",
    // Leave mutation off until POST /api/admin/agent-lifecycle-sweep (a dry run by default)
    // has been reviewed.
    "AGENT_LIFECYCLE_SWEEP_APPLY": "false",
    // Optional hardening/integration vars (see README.md > Productionizing):
    // "CIMD_ALLOWED_HOSTS": "chatgpt.com,claude.ai",
    // "SIGNAL_WEBHOOK_URL": "https://hooks.example.com/noriq",
    // "MAINTENANCE_MODE": "false"
  },

  // Secrets never belong in this file. Add only the ones you use:
  //   npx wrangler secret put ADMIN_TOKEN --config wrangler.production.jsonc
  //   npx wrangler secret put ATTACHMENT_UPLOAD_SECRET --config wrangler.production.jsonc
  //   npx wrangler secret put GITHUB_WEBHOOK_SECRET --config wrangler.production.jsonc
  //   npx wrangler secret put SIGNAL_WEBHOOK_SECRET --config wrangler.production.jsonc

  // OPTIONAL — task attachments. Requires R2 enabled on the account, then:
  //   wrangler r2 bucket create noriq-files
  // Delete if unused; the attachments UI reports it as not configured.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "noriq-files" }],


  // OPTIONAL — semantic + code-intelligence search. AI needs no provisioning. The two
  // Vectorize indexes are independent: authored memory/search belongs in noriq-search, while
  // repository generations belong in noriq-code and may churn without touching memory.
  //   wrangler vectorize create noriq-search --dimensions=1024 --metric=cosine
  //   wrangler vectorize create-metadata-index noriq-search --property-name=projectId --type=string
  //   wrangler vectorize create noriq-code --dimensions=1024 --metric=cosine
  //   wrangler vectorize create-metadata-index noriq-code --property-name=projectId --type=string
  //   wrangler vectorize create-metadata-index noriq-code --property-name=repositoryKey --type=string
  //   wrangler vectorize create-metadata-index noriq-code --property-name=generationId --type=string
  // Delete either binding if unused. Retrieval transparently retains lexical + graph search.
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "noriq-search" },
    { "binding": "CODE_VECTORIZE", "index_name": "noriq-code" }
  ],

  // Daily D1 backup to R2 at 06:00 UTC (PLNR-21); snapshots land under backups/ (see BACKUP.md).
  "triggers": { "crons": ["0 6 * * *"] },

  "observability": { "enabled": true }
}
